{
  "_source": "Derived from @trngthnh369/n8n-workflow-validator SECRET_PATTERNS (validator.ts). Regenerate when the validator changes. action=block → PreToolUse exit(2); action=warn → stderr only (exit 0).",
  "_version_note": "18 patterns: 17 high-entropy provider patterns (block) + 1 generic (warn — avoids false-positive blocks on legit field names like token/secret/password).",
  "patterns": [
    { "name": "Bearer token", "re": "Bearer\\s+[A-Za-z0-9\\-._~+/]{20,}", "flags": "", "action": "block" },
    { "name": "JWT", "re": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}", "flags": "", "action": "block" },
    { "name": "AWS access key", "re": "AKIA[0-9A-Z]{16}", "flags": "", "action": "block" },
    { "name": "AWS session token", "re": "ASIA[0-9A-Z]{16}", "flags": "", "action": "block" },
    { "name": "Google API key", "re": "AIza[0-9A-Za-z_-]{35}", "flags": "", "action": "block" },
    { "name": "Slack token", "re": "xox[baprs]-[0-9A-Za-z-]{10,}", "flags": "", "action": "block" },
    { "name": "GitHub PAT (classic)", "re": "ghp_[A-Za-z0-9]{36}", "flags": "", "action": "block" },
    { "name": "GitHub OAuth token", "re": "gho_[A-Za-z0-9]{36}", "flags": "", "action": "block" },
    { "name": "GitHub user-to-server", "re": "ghu_[A-Za-z0-9]{36}", "flags": "", "action": "block" },
    { "name": "GitHub server-to-server", "re": "ghs_[A-Za-z0-9]{36}", "flags": "", "action": "block" },
    { "name": "GitHub refresh token", "re": "ghr_[A-Za-z0-9]{36}", "flags": "", "action": "block" },
    { "name": "Stripe live secret key", "re": "sk_live_[A-Za-z0-9]{24,}", "flags": "", "action": "block" },
    { "name": "Stripe live restricted key", "re": "rk_live_[A-Za-z0-9]{24,}", "flags": "", "action": "block" },
    { "name": "OpenAI API key", "re": "sk-(proj-)?[A-Za-z0-9_-]{32,}", "flags": "", "action": "block" },
    { "name": "Anthropic API key", "re": "sk-ant-[A-Za-z0-9_-]{32,}", "flags": "", "action": "block" },
    { "name": "PEM private key", "re": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----", "flags": "", "action": "block" },
    { "name": "SSH private key header", "re": "-----BEGIN OPENSSH PRIVATE KEY-----", "flags": "", "action": "block" },
    { "name": "Generic api_key/secret/password/token literal", "re": "[\"']?(api[_-]?key|apikey|secret|password|token)[\"']?\\s*[:=]\\s*[\"'][A-Za-z0-9_\\-]{16,}[\"']", "flags": "i", "action": "warn" }
  ]
}
